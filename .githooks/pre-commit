#!/usr/bin/env sh
set -eu

root="$(git rev-parse --show-toplevel)"
cd "$root"

changed_files="$(git diff --cached --name-only --diff-filter=ACMRD)"

if [ -z "$changed_files" ]; then
  exit 0
fi

module_changed=0
while IFS= read -r path; do
  case "$path" in
    app/*|worker/*)
      module_changed=1
      ;;
  esac
done <<EOF
$changed_files
EOF

if [ "$module_changed" -eq 0 ]; then
  echo "pre-commit: no module changes detected; skipping README freshness check."
  exit 0
fi

if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: node is required to check module README freshness." >&2
  exit 1
fi

echo "pre-commit: checking staged module README freshness"
node .github/scripts/readme-freshness.mjs check --staged
